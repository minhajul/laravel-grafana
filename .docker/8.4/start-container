#!/usr/bin/env bash

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R u=rwX,g=rX,o= /.composer

if [ ! -z "$WWWGROUP" ]; then
    groupmod -g $WWWGROUP sail
fi

# Only the runtime-writable directories need to belong to sail. Recursing over the
# whole bind mount (vendor/, node_modules/, ...) on every start is slow, and with
# WWWUSER/WWWGROUP set (as `sail up` does) sail already matches the host owner.
for writable_dir in /var/www/html/storage /var/www/html/bootstrap/cache; do
    if [ -d "$writable_dir" ]; then
        chown -R sail:sail "$writable_dir"
    fi
done

if [ -f /var/www/html/artisan ]; then
    chmod +x /var/www/html/artisan
fi

exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
